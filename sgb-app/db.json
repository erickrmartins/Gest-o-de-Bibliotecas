    {"id": "21", "nome": "Harry Potter e a Pedra Filosofal", "isbn": "9788532511010", "dtPublicacao": "1997", "numPaginas": 263, "sinopsis": "Harry Potter vive com os tios, que o maltratam, até receber, em seu aniversário de onze anos, a notícia de que é um bruxo. Ele é levado à Escola de Magia e Bruxaria de Hogwarts, onde descobre a verdade sobre a morte de seus pais e enfrenta o bruxo Voldemort.", "idAutores": ["J.K. Rowling"], "idGeneros": "Fantasia", "idEditoras": "Rocco", "ativo": true, "recomendado": true},
    {"id": "22", "nome": "A Revolução dos Bichos", "isbn": "9788535909555", "dtPublicacao": "1945", "numPaginas": 152, "sinopsis": "Os animais de uma fazenda expulsam o dono humano e tentam criar uma sociedade igualitária. Com o tempo, os porcos assumem o comando e instauram uma tirania ainda mais opressiva, numa fábula política inspirada na União Soviética.", "idAutores": ["George Orwell"], "idGeneros": "Sátira", "idEditoras": "Companhia das Letras", "ativo": true, "recomendado": true},
    {"id": "23", "nome": "Fahrenheit 451", "isbn": "9781451673319", "dtPublicacao": "1953", "numPaginas": 249, "sinopsis": "Em uma sociedade futura que proíbe os livros, o bombeiro Guy Montag tem a função de queimá-los. Ao conhecer uma jovem vizinha e questionar sua rotina, ele começa a duvidar do sistema que serve.", "idAutores": ["Ray Bradbury"], "idGeneros": "Distopia", "idEditoras": "Simon & Schuster", "ativo": true, "recomendado": true},
